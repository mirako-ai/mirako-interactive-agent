{
  "name": "mirako-interactive-agent",
  "description": "Mirako interactive Cloudflare AI agent with one configurable chat API.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx wrangler dev",
